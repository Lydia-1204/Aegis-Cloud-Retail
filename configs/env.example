# 复制为各服务目录下的 .env 或根目录 .env 后使用（勿提交真实密钥）

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev

# 两个 Go 微服务共用同一 PostgreSQL 数据库（库名 aegis_go）
GO_DATABASE_URL=postgres://aegis:aegis_dev@localhost:5432/aegis_go?sslmode=disable
# 兼容旧变量名；若未设置 GO_DATABASE_URL，两 Go 服务仍可读 DATABASE_URL
DATABASE_URL=postgres://aegis:aegis_dev@localhost:5432/aegis_go?sslmode=disable

# 两个 Python 微服务共用同一 PostgreSQL 数据库（库名 aegis_python）
PYTHON_DATABASE_URL=postgres://aegis:aegis_dev@localhost:5432/aegis_python?sslmode=disable

FOUNDATION_DATA_HTTP_ADDR=:8081
STORE_OPS_HTTP_ADDR=:8082

TRAFFIC_SENSE_HTTP_ADDR=:8083
AI_ASSISTANT_HTTP_ADDR=:8084

# 数据库迁移（golang-migrate CLI，仅针对 aegis_go）
# 安装: https://github.com/golang-migrate/migrate
# 执行: migrate -path database/migrations/go -database "postgres://aegis:aegis_dev@localhost:5432/aegis_go?sslmode=disable" up
# 回滚一步: ... down 1
